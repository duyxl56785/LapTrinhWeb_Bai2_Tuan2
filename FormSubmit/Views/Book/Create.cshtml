@model FormSubmit.Models.Book

@{
    ViewData["Title"] = "Thêm sách mới";
}

<div class="container mt-4" style="max-width: 500px;">
    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <h4>Thêm sách mới</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" novalidate>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Tên sách:</label>
                    <input asp-for="Name" class="form-control" placeholder="Nhập tên sách..." />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Giá sách:</label>
                    <input asp-for="Price" type="number" step="any" class="form-control" placeholder="Nhập giá sách..." />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
                    <button type="submit" class="btn btn-success">Thêm sách</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}